<%- include("../partials/header") %>
<div class="card narrow">
  <h1><%= project ? "프로젝트 수정" : "새 프로젝트" %></h1>
  <form action="/projects<%= project ? `/${project._id}?_method=PUT` : "" %>" method="POST">
    <label>프로젝트 이름<input type="text" name="name" value="<%= project ? project.name : "" %>" required></label>
    <label>설명<textarea name="description" rows="4"><%= project ? project.description : "" %></textarea></label>
    <div class="actions">
      <a href="<%= project ? `/projects/${project._id}` : "/projects" %>" class="btn">Cancel</a>
      <button type="submit" class="primary">저장</button>
    </div>
  </form>
</div>
<%- include("../partials/footer") %>
